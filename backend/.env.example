DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
FRONTEND_URL="http://localhost:5173"
AI_PROVIDER="mock"

# ---- PostgreSQL (optional) -------------------------------------------------
# Untuk berpindah ke PostgreSQL:
# 1. Set provider = "postgresql" di prisma/schema.prisma
# 2. Update URL di bawah lalu jalankan: npm run db:setup
# DATABASE_URL="postgresql://user:password@localhost:5432/techtutor?schema=public"

# ---- AI (mode produksi/opsional) -------------------------------------------
# TechTutor AI memakai router template deterministik (AI_PROVIDER=mock).
# Jalur LLM asli hanya dokumentasi; tanpa dependensi aktif.
# OPENAI_API_KEY=

# ---- Vite frontend proxy (opsional) ----------------------------------------
# Biarkan default bila backend di localhost:5000.
# API_TARGET=http://localhost:5001