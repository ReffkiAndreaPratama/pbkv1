// TechTutor - Prisma schema
// Adaptive troubleshooting learning platform (Pembelajaran Berbasis Kasus)
// Default provider: SQLite. PostgreSQL: set provider + DATABASE_URL, run db:setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LearningStyle {
  VISUAL
  TEKS
  PRAKTIK
}

enum TargetLevel {
  DASAR
  MENENGAH
  MAHIR
}

enum QuizType {
  PRETEST
  POSTTEST
  ADAPTIVE
}

enum SimStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum NodeType {
  START
  DIAGNOSTIC
  ACTION
  DECISION
  SOLUTION
  FAIL
}

enum ActivityType {
  PRETEST
  POSTTEST
  CASE_SUBMIT
  MATERIAL_READ
  QUIZ_ANSWER
  ACHIEVEMENT
  TUTOR_CHAT
  STREAK
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            LearningProfile?
  skillMastery       SkillMastery[]
  materialReads      MaterialRead[]
  simulationAttempts SimulationAttempt[]
  quizSessions       QuizSession[]
  activityLog        ActivityLog[]
  userAchievements   UserAchievement[]
}

model LearningProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  learningStyle  LearningStyle @default(TEKS)
  targetLevel    TargetLevel   @default(MENENGAH)
  waktuPerSesiMin Int          @default(30)
  skillPriority  Json?
  totalXp        Int           @default(0)
  level          Int           @default(1)
  streakDays     Int           @default(0)
  lastActiveDate DateTime?
  pretestDone    Boolean       @default(false)
  posttestDone   Boolean       @default(false)
  posttestScore  Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String

  materials       Material[]
  cases           CaseModel[]
  questions       Question[]
  skillMastery    SkillMastery[]
}

model SkillMastery {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  mastery    Float    @default(0)
  attempts   Int      @default(0)
  successes  Int      @default(0)
  lastUpdated DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Material {
  id       String  @id @default(cuid())
  skillId  String
  title    String
  summary  String
  content  String
  order    Int     @default(0)
  isActive Boolean @default(true)
  imageUrl String?
  videoUrl String?
  links    Json?

  skill       Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  materialRead MaterialRead[]

  @@index([skillId])
}

model MaterialRead {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  readAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model CaseModel {
  id              String     @id @default(cuid())
  skillId         String
  title           String
  scenario        String
  difficulty      Difficulty @default(MEDIUM)
  targetSteps     Int        @default(5)
  expectedTimeSec Int        @default(300)
  isActive        Boolean    @default(true)
  order           Int        @default(0)
  createdAt       DateTime   @default(now())

  skill         Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  nodes         CaseNode[]
  attempts      SimulationAttempt[]
  options       CaseOption[]

  @@index([skillId])
}

model CaseNode {
  id          String   @id @default(cuid())
  caseId      String
  nodeKey     String
  type        NodeType
  text        String
  detail      String?
  isOnBestPath Boolean @default(false)

  case     CaseModel    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  options  CaseOption[] @relation("NodeOptions")
  incoming CaseOption[] @relation("OptionTarget")

  @@unique([caseId, nodeKey])
}

model CaseOption {
  id           String   @id @default(cuid())
  nodeId       String
  label        String
  nextNodeId   String?
  isCorrect    Boolean  @default(false)
  condition    Json?
  effect       Json?
  feedbackText String?

  node     CaseModel @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String

  nextNode CaseNode? @relation("OptionTarget", fields: [nextNodeId], references: [id], onDelete: SetNull)
  nodeOf   CaseNode  @relation("NodeOptions", fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

model SimulationAttempt {
  id          String    @id @default(cuid())
  userId      String
  caseId      String
  status      SimStatus @default(IN_PROGRESS)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  totalMoves  Int       @default(0)
  wrongMoves  Int       @default(0)
  hintsUsed   Int       @default(0)
  fullAnswerGiven Boolean @default(false)
  timeSec     Int       @default(0)
  success     Boolean?
  score       Float?
  accuracy    Float?
  signalState Json?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case  CaseModel @relation(fields: [caseId], references: [id], onDelete: Cascade)
  steps SimulationStep[]

  @@index([userId])
}

model SimulationStep {
  id          String   @id @default(cuid())
  attemptId   String
  nodeKey     String
  optionLabel String
  wasCorrect  Boolean
  hintLevel   Int      @default(0)
  at          DateTime @default(now())

  attempt SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model Question {
  id          String     @id @default(cuid())
  skillId     String
  prompt      String
  type        String     @default("MCQ")
  options     Json
  correctKeys Json
  explanation String
  difficulty  Difficulty @default(MEDIUM)
  phases      Json
  imageUrl    String?
  videoUrl    String?
  isActive    Boolean    @default(true)

  skill     Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  @@index([skillId])
}

model QuizSession {
  id           String    @id @default(cuid())
  userId       String
  type         QuizType
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  score        Float?
  correctCount Int       @default(0)
  totalCount   Int       @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id           String   @id @default(cuid())
  sessionId    String
  questionId   String
  selectedKeys Json
  isCorrect    Boolean
  hintUsed     Boolean  @default(false)

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  refId     String?
  meta      Json?
  points    Int          @default(0)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String
  condition   Json
  xpReward    Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}